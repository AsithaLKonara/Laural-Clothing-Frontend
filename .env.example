# ==========================================
# LAURAL CLOTHING - FRONTEND ENVIRONMENT VARIABLES
# ==========================================

# ─── API Connection ──────────────────────────────────────────────────────────
# Backend API URL (no trailing slash)
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"

# ─── Site URLs ───────────────────────────────────────────────────────────────
# Main site URL (used for SEO, metadata, canonicals)
NEXT_PUBLIC_SITE_URL="https://laural.lk"
NEXT_PUBLIC_BASE_URL="https://laural.lk"

# ─── Security ────────────────────────────────────────────────────────────────
# Cloudflare Turnstile CAPTCHA (public site key)
# Get from: https://dash.cloudflare.com → Turnstile → your site → Site Key
# Test site key (always passes, invisible widget): 1x00000000000000000000AA
# Test site key (always passes, visible widget):  1x00000000000000000000BB
# Test site key (always blocks):                  2x00000000000000000000AB
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Auth secret for NextAuth / edge middleware JWT signing (if applicable)
AUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Optimization & Analytics ────────────────────────────────────────────────
# Enable Next.js bundle analyzer (true/false)
ANALYZE="false"
