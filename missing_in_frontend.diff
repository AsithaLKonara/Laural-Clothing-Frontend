+                  </div>
+
+                  {/* Step 2: Processing */}
+                  <div className="flex flex-col items-center gap-4 z-10 w-[100px]">
+                    <div className={`w-[50px] h-[50px] rounded-full flex items-center justify-center shadow-sm transition-colors duration-500
