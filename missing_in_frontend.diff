+
+  // Determine current status step
+  // status enum: PENDING, PAID, PROCESSING, DISPATCHED, DELIVERED, CANCELLED
+  // fardar status: PENDING, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RETURNED
+  
+  let currentStep = 0; // Default
+  
+  if (orderData) {
+    if (orderData.status === 'PENDING' || orderData.status === 'PAID') currentStep = 1;
+    if (orderData.status === 'PROCESSING') currentStep = 2;
+    if (orderData.status === 'DISPATCHED') currentStep = 3;
+    if (orderData.status === 'DELIVERED') currentStep = 4;
+
+    if (orderData.trackingInfo) {
+      const ts = orderData.trackingInfo.status;
