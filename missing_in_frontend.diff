+      {/* Recent Transactions */}
+      <div className="bg-white border border-stone-200 rounded-2xl shadow-sm overflow-hidden mt-5">
+        <RecentTransactionsTable transactions={analytics?.recentTransactions} />
+      </div>
+
+      <div className="h-6" />
+    </div>
+  );
+}
