+"use client";
+
+import Image from "next/image";
+import { useState, useEffect } from "react";
+
+const HERO_IMAGES = [
+  "/hero-image/hero-1.jpg",
+  "/hero-image/hero-2.jpg",
+  "/hero-image/hero-3.jpg",
+];
+
+export default function Hero() {
+  const [currentIndex, setCurrentIndex] = useState(0);
+
+  useEffect(() => {
+    const timer = setInterval(() => {
+      setCurrentIndex((prevIndex) => (prevIndex + 1) % HERO_IMAGES.length);
+    }, 5000); // 5 second intervals
+
+    return () => clearInterval(timer);
+  }, []);
+
+  return (
+    <section className="relative w-full h-[80vh] min-h-[500px] md:h-[829px] overflow-hidden bg-stone-100">
+      {/* Carousel Images */}
+      {HERO_IMAGES.map((src, index) => (
+        <Image
+          key={src}
+          src={src}
+          alt={`Hero Image ${index + 1}`}
+          fill
+          priority={index === 0}
+          className={`object-cover object-top transition-opacity duration-1000 ease-in-out ${
+            index === currentIndex ? "opacity-100" : "opacity-0"
+          }`}
+        />
+      ))}
+
+      {/* Gradient Overlay */}
+      {/* 
+        Matches user spec: 
