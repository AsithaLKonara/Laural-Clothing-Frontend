+      const params = new URLSearchParams();
+      if (branchId) params.append('branchId', branchId);
+      const res = await api.get(`/inventory/stats?${params.toString()}`);
+      return res.data;
+    },
+  });
+};
+
+export const useAdjustStock = () => {
