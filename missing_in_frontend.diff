+      </div>
+    </div>
+  );
+}
+
+// ─── Main Page ─────────────────────────────────────────────────────────────────
+
+const TABS = [
+  { id: "hero", label: "Hero Slides", icon: ImageIcon },
+  { id: "banners", label: "Promo Banners", icon: Megaphone },
+  { id: "homepage", label: "Homepage Layout", icon: Layout },
+  { id: "pages", label: "Static Pages", icon: FileText },
