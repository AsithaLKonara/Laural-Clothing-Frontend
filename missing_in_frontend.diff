+          <button
+            onClick={bulkReject}
+            className="font-inter font-semibold text-sm bg-red-500 text-white px-4 py-2 rounded-full hover:bg-red-400 transition-colors flex items-center gap-2"
+          >
+            <X size={14} /> Reject All
+          </button>
+        </div>
+      )}
+    </div>
+  );
+}
