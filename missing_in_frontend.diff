+                View Reports &rarr;
+              </div>
+            </div>
+          );
+
+          return report.href ? (
+            <Link href={report.href} key={idx}>
+              {content}
+            </Link>
+          ) : (
+            <div key={idx} className="opacity-50 cursor-not-allowed">
+              {content}
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
