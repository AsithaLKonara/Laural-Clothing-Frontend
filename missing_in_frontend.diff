+          <span className="text-stone-300">·</span>
+          <button onClick={() => setPrintingProduct({ sku: row.sku || row.id, name: row.name })} className="text-stone-500 hover:text-stone-900 transition-colors tooltip" title="Print Barcode">
+            <Barcode size={16} />
+          </button>
+        </div>
+      ),
+    },
+  ];
+
+  const filters = (
+    <>
