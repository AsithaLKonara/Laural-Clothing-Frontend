+              addToCart(product, matchingVariant, 1);
+              setSearchTerm("");
+            }
+          }
+        } catch (err) {
+          console.error("Barcode scan failed", err);
+        }
+      }
+    }
+  };
+
+  const filteredProducts = products; // Already filtered by backend!
+
+  return (
