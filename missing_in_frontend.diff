+          <span className="text-stone-300">·</span>
+          <button 
+            className="text-xs text-red-500 hover:underline font-medium"
+            onClick={async (e) => { 
+              e.stopPropagation(); 
+              if(await globalDialog.confirm('Delete this coupon?')) { 
