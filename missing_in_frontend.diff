+                            >
+                              <Check size={15} />
+                            </button>
+                            <button
+                              onClick={() => reject(review.id)}
+                              title="Reject"
+                              className="w-8 h-8 flex items-center justify-center bg-red-50 text-red-700 border border-red-200 rounded-lg hover:bg-red-100 transition-colors shadow-sm"
