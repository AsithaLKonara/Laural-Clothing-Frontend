+                          <span className="font-poppins font-light text-xs text-stone-500 uppercase tracking-wider">
+                            Qty: {item.quantity}
+                          </span>
+                        </div>
+                      </div>
+                    </div>
+                  ))}
+                </div>
+
+                <div className="w-full pt-6 border-t border-stone-200 flex justify-between items-center">
+                  <span className="font-poppins font-medium text-sm text-stone-500">Order Total</span>
+                  <span className="font-poppins font-semibold text-lg text-primary">Rs. {orderData.total?.toFixed(2)}</span>
+                </div>
+
+              </div>
+            </>
+          ) : null}
+        </section>
+      )}
+    </main>
+  );
+}
