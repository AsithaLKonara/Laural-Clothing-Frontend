+        {isLoading ? (
+          <div className="p-8 text-center text-stone-500">Loading branches...</div>
+        ) : (
+          <DataTable
+            columns={columns}
+            data={branches}
+            keyExtractor={(row) => row.id}
+            onRowClick={(row) => console.log("Branch selected:", row)}
