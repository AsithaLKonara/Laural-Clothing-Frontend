+          id: `SCAN-${Math.floor(Math.random() * 1000)}`,
+          name: "Scanned Item",
+          size: "O/S",
+          price: 3500,
+          image: "/products/default.jpg",
+          returned: false,
+          isScanned: true
+        };
+        setSelectedItems(prev => [...prev, newItem]);
