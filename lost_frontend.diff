+        initialData={editingCoupon} 
+      />
+      <FlashSaleModal 
+        isOpen={flashSaleModalOpen} 
+        onClose={() => { setFlashSaleModalOpen(false); setEditingFlashSale(null); }} 
+        initialData={editingFlashSale} 
+      />
+    </div>
+  );
+}
